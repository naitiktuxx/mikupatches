<?xml version="1.0" encoding="utf-8"?>
<rotate xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromDegrees="0.0"
    android:toDegrees="1080.0"
    android:pivotX="50.0%"
    android:pivotY="50.0%">
    <shape
        android:shape="ring"
        android:innerRadius="28.0dp"
        android:thickness="3.5dp"
        android:useLevel="false">
        <gradient
            android:type="sweep"
            android:useLevel="false"
            android:startColor="#00e50914"
            android:centerColor="#80e50914"
            android:endColor="#ffe50914"
            android:centerY="0.5"
            android:centerX="0.5" />
    </shape>
</rotate>
