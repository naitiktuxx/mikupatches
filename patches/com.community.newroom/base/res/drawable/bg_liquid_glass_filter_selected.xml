<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20.0dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#59FFFFFF"
                android:centerColor="#38FFFFFF"
                android:endColor="#24FFFFFF" />
            <stroke
                android:width="1.2dp"
                android:color="#99FFFFFF" />
        </shape>
    </item>
    <item android:bottom="14.0dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="20.0dp"
                android:topRightRadius="20.0dp"
                android:bottomLeftRadius="6.0dp"
                android:bottomRightRadius="6.0dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#33FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
