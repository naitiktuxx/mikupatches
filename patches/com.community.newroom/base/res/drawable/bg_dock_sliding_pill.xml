<?xml version="1.0" encoding="utf-8"?>
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="6.0dp"
    android:insetRight="6.0dp"
    android:insetTop="3.0dp"
    android:insetBottom="3.0dp">
    <layer-list>
        <!-- BitChord-style pure white frosted glass lift pill -->
        <item>
            <shape android:shape="rectangle">
                <corners android:radius="24.0dp" />
                <gradient
                    android:type="linear"
                    android:angle="270"
                    android:startColor="#4DFFFFFF"
                    android:centerColor="#26FFFFFF"
                    android:endColor="#14FFFFFF" />
                <stroke
                    android:width="1.2dp"
                    android:color="#80FFFFFF" />
            </shape>
        </item>
        <!-- Pill upper specular glare -->
        <item android:bottom="22.0dp">
            <shape android:shape="rectangle">
                <corners
                    android:topLeftRadius="24.0dp"
                    android:topRightRadius="24.0dp"
                    android:bottomLeftRadius="8.0dp"
                    android:bottomRightRadius="8.0dp" />
                <gradient
                    android:type="linear"
                    android:angle="270"
                    android:startColor="#40FFFFFF"
                    android:endColor="#00FFFFFF" />
            </shape>
        </item>
    </layer-list>
</inset>
