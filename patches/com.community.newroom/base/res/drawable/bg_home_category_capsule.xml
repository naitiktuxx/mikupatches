<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Liquid glass translucent base container -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18.0dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#591E2738"
                android:centerColor="#66121724"
                android:endColor="#73090C12" />
            <stroke
                android:width="1.0dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>

    <!-- Upper specular glass reflection glint -->
    <item android:bottom="18.0dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="18.0dp"
                android:topRightRadius="18.0dp"
                android:bottomLeftRadius="6.0dp"
                android:bottomRightRadius="6.0dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#33FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
