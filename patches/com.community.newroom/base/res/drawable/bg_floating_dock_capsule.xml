<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer ambient subtle halo -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30.0dp" />
            <stroke
                android:width="1.0dp"
                android:color="#1AFFFFFF" />
        </shape>
    </item>

    <!-- Translucent frosted liquid glass acrylic body -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30.0dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#591E2738"
                android:centerColor="#66121724"
                android:endColor="#73090C12" />
            <stroke
                android:width="1.2dp"
                android:color="#66FFFFFF" />
        </shape>
    </item>

    <!-- Specular top highlight (upper glass refraction glint) -->
    <item android:bottom="30.0dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="30.0dp"
                android:topRightRadius="30.0dp"
                android:bottomLeftRadius="12.0dp"
                android:bottomRightRadius="12.0dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#40FFFFFF"
                android:centerColor="#14FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <!-- Bottom edge subtle refraction sheen -->
    <item android:top="56.0dp" android:left="20.0dp" android:right="20.0dp">
        <shape android:shape="rectangle">
            <corners android:radius="2.0dp" />
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#26FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
