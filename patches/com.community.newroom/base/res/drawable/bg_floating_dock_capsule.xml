<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30.0dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#F2222834"
                android:centerColor="#FA13161F"
                android:endColor="#FD090B0F" />
            <stroke
                android:width="1.2dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>
    <item android:bottom="28.0dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="30.0dp"
                android:topRightRadius="30.0dp"
                android:bottomLeftRadius="10.0dp"
                android:bottomRightRadius="10.0dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#26FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
