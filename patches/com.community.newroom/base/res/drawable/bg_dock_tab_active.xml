<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24.0dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#4DFFFFFF"
                android:centerColor="#26FFFFFF"
                android:endColor="#14FFFFFF" />
            <stroke
                android:width="1.2dp"
                android:color="#80FFFFFF" />
        </shape>
    </item>
    <item android:bottom="20.0dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="24.0dp"
                android:topRightRadius="24.0dp"
                android:bottomLeftRadius="8.0dp"
                android:bottomRightRadius="8.0dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
