<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Pure matte dark surface - zero blur/alpha overhead -->
    <solid android:color="#FF16161A" />
    
    <!-- Crisp 1dp subtle border -->
    <stroke
        android:width="1dp"
        android:color="#FF2A2A32" />
        
    <!-- Full pill stadium corners -->
    <corners android:radius="999dp" />
</shape>
