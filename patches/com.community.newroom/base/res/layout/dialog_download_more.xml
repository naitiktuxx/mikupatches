<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/libui_common_bottom_dialog_bg"
    android:paddingTop="12.0dp"
    android:paddingBottom="16.0dp">

    <View
        android:layout_width="38.0dp"
        android:layout_height="4.0dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2.0dp"
        android:layout_marginBottom="10.0dp"
        android:background="@drawable/bg_radius_4_color_white_10p" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@id/tv_cancel"
        android:layout_width="match_parent"
        android:layout_height="52.0dp"
        android:gravity="center"
        android:text="@string/cancel"
        android:textColor="@color/text_01"
        android:textSize="16.0sp"
        android:textStyle="bold" />
</LinearLayout>
