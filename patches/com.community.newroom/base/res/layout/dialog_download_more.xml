<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@drawable/libui_common_bottom_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="12.0dp"
    android:paddingBottom="12.0dp"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <View
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_liquid_glass_filter_unselected"
        android:layout_width="40.0dp"
        android:layout_height="4.0dp"
        android:layout_marginBottom="12.0dp" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
    <View
        android:background="@color/white_10"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="8.0dp"
        android:layout_marginBottom="4.0dp" />
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16.0sp"
        android:textStyle="bold"
        android:textColor="@color/white_80"
        android:gravity="center"
        android:id="@id/tv_cancel"
        android:layout_width="match_parent"
        android:layout_height="50.0dp"
        android:text="@string/cancel" />
</LinearLayout>
