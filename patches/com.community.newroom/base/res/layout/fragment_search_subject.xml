<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:background="@color/gray_dark_00"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/ll_top"
        android:paddingLeft="12.0dp"
        android:paddingRight="12.0dp"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="52.0dp"
        android:paddingHorizontal="12.0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@id/iv_cancel"
            android:layout_width="24.0dp"
            android:layout_height="24.0dp"
            android:src="@drawable/libui_ic_base_left"
            android:tint="@color/white" />
        <RelativeLayout
            android:background="@drawable/bg_search_bar_capsule"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="0.0dp"
            android:layout_height="38.0dp"
            android:layout_weight="1.0"
            android:layout_marginStart="10.0dp">
            <ImageView
                android:id="@id/comment_input_search_icon"
                android:layout_width="16.0dp"
                android:layout_height="16.0dp"
                android:src="@drawable/ic_search_ic"
                android:layout_centerVertical="true"
                android:layout_marginStart="14.0dp"
                app:tint="@color/white_80" />
            <TextView
                android:id="@id/tv_search"
                android:textSize="12.0sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:background="@drawable/bg_search_btn_pill"
                android:paddingStart="12.0dp"
                android:paddingEnd="12.0dp"
                android:layout_width="wrap_content"
                android:layout_height="28.0dp"
                android:text="@string/search"
                android:layout_marginEnd="6.0dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                style="@style/style_import_text" />
            <ImageView
                android:id="@id/search_edit_clear"
                android:padding="5.0dp"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_clear"
                android:layout_centerVertical="true"
                android:contentDescription="@string/clear"
                android:layout_marginEnd="4.0dp"
                android:layout_toStartOf="@id/tv_search" />
            <EditText
                android:id="@id/comment_input_edit_text"
                android:textSize="@dimen/text_size_14"
                android:textColor="@color/white"
                android:textColorHint="@color/white_60"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:autoLink="none"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="8.0dp"
                android:layout_marginEnd="6.0dp"
                android:maxHeight="88.0dp"
                android:minHeight="35.0dp"
                android:hint="@string/search_hint_input"
                android:maxLines="1"
                android:singleLine="true"
                android:maxLength="200"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:textCursorDrawable="@drawable/cursor_color_p"
                android:layout_toStartOf="@id/search_edit_clear"
                android:layout_toEndOf="@id/comment_input_search_icon"
                style="@style/style_regular_text" />
        </RelativeLayout>
        <com.transsion.search_pugc.speech.SpeechRecognizerView
            android:id="@id/sRView"
            android:visibility="gone"
            android:layout_width="0.0dp"
            android:layout_height="0.0dp" />
    </LinearLayout>
    <View
        android:id="@id/top_line"
        android:background="@color/border"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_top" />
    <FrameLayout
        android:id="@id/search_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0.0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_line" />
</androidx.constraintlayout.widget.ConstraintLayout>
