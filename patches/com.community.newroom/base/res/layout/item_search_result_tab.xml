<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:animateLayoutChanges="true"
    android:paddingTop="10.0dp"
    android:paddingBottom="10.0dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="6.0dp"
    android:layout_marginEnd="6.0dp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView
        android:id="@id/search_result_tab_select_text"
        android:textSize="@dimen/text_size_14"
        android:textColor="@color/white"
        android:gravity="center"
        android:background="@drawable/bg_liquid_glass_filter_selected"
        android:paddingStart="16.0dp"
        android:paddingTop="7.0dp"
        android:paddingEnd="16.0dp"
        android:paddingBottom="7.0dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/style_medium_text" />
    <TextView
        android:id="@id/search_result_tab_default_text"
        android:textSize="@dimen/text_size_14"
        android:textColor="@color/white_80"
        android:gravity="center"
        android:background="@drawable/bg_liquid_glass_filter_unselected"
        android:paddingStart="16.0dp"
        android:paddingTop="7.0dp"
        android:paddingEnd="16.0dp"
        android:paddingBottom="7.0dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/style_regular_text" />
</androidx.constraintlayout.widget.ConstraintLayout>
