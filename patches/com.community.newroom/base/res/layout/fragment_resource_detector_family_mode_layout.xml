<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="12.0dp"
    android:paddingRight="12.0dp"
    android:paddingBottom="16.0dp"
    android:paddingHorizontal="12.0dp">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@id/innerTvTitle"
        style="@style/style_import_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24.0dp"
        android:drawablePadding="3.0dp"
        android:includeFontPadding="false"
        android:text="@string/name_resource"
        android:textColor="@color/text_01"
        android:textSize="16.0sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@id/innerTvInfo"
        style="@style/style_regular_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4.0dp"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/movie_uploaded_by"
        android:textAlignment="viewStart"
        android:textColor="@color/white_60"
        app:layout_constraintBottom_toBottomOf="@id/innerTvTitle"
        app:layout_constraintEnd_toStartOf="@id/innerTvName"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@id/innerTvTitle"
        app:layout_constraintTop_toTopOf="@id/innerTvTitle" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@id/innerTvName"
        style="@style/style_medium_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4.0dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textColor="@color/white_60"
        android:textSize="12.0sp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@id/innerTvTitle"
        app:layout_constraintEnd_toStartOf="@id/innerIcon"
        app:layout_constraintStart_toEndOf="@id/innerTvInfo"
        app:layout_constraintTop_toTopOf="@id/innerTvTitle" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@id/innerIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4.0dp"
        android:layout_marginEnd="12.0dp"
        android:tint="@color/white_60"
        app:layout_constraintBottom_toBottomOf="@id/innerTvTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/innerTvName"
        app:layout_constraintTop_toTopOf="@id/innerTvTitle"
        app:layout_goneMarginEnd="2.0dp"
        app:srcCompat="@drawable/ic_source_feedback_enter" />

    <androidx.cardview.widget.CardView
        android:layout_width="0.0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="1.0dp"
        android:layout_marginTop="8.0dp"
        android:layout_marginRight="1.0dp"
        android:layout_marginHorizontal="1.0dp"
        android:textAlignment="center"
        app:cardBackgroundColor="@color/white_6"
        app:cardCornerRadius="8.0dp"
        app:cardElevation="0.0dp"
        app:cardMaxElevation="0.0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/innerTvTitle"
        app:layout_constraintVertical_bias="1.0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="16.0dp"
            android:paddingTop="14.0dp"
            android:paddingRight="16.0dp"
            android:paddingBottom="16.0dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@id/tvContentTitle"
                style="@style/style_medium_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@mipmap/ic_kid_mode_tips"
                android:drawablePadding="6.0dp"
                android:text="@string/movie_detail_res_unavailable"
                android:textColor="@color/text_01" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@id/tvContentTips"
                style="@style/style_regular_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6.0dp"
                android:text="@string/movie_detail_res_unavailable_tips"
                android:textColor="@color/white_60" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@id/btn_download"
                android:layout_width="wrap_content"
                android:layout_height="36.0dp"
                android:layout_marginTop="14.0dp"
                android:background="@drawable/bg_btn_play_anyway"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingLeft="24.0dp"
                android:paddingRight="24.0dp"
                android:text="Play anyway"
                android:textColor="#FF000000"
                android:textSize="13.0sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
