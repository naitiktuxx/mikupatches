<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:background="@color/module_01"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.transsion.wrapperad.view.secondfloor.TrendingTwoLevelIrregularView
        android:id="@id/secondFloorAdView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@id/container"
        android:layout_width="match_parent"
        android:layout_height="0.0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.transsion.wrapperad.view.secondfloor.SecondFloorArcCoverView
        android:id="@id/arcCover"
        android:visibility="gone"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@id/tabBg"
        android:visibility="gone"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@id/leftBg"
        android:visibility="gone"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@id/leftTwoBg"
        android:visibility="gone"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@id/centerBg"
        android:visibility="gone"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@id/rightTwoBg"
        android:visibility="gone"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@id/rightBg"
        android:visibility="gone"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Group
        android:id="@id/largeBottomBg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="rightBg,rightTwoBg,centerBg,leftBg,leftTwoBg" />

    <com.google.android.material.tabs.TabLayout
        android:id="@id/tab_bottom"
        android:background="@drawable/bg_floating_dock_capsule"
        android:elevation="14.0dp"
        android:clipToOutline="true"
        android:layout_width="0.0dp"
        android:layout_height="60.0dp"
        android:layout_marginStart="24.0dp"
        android:layout_marginEnd="24.0dp"
        android:layout_marginBottom="16.0dp"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabPaddingStart="0.0dp"
        app:tabPaddingEnd="0.0dp"
        app:tabIndicator="@drawable/bg_dock_sliding_pill"
        app:tabIndicatorColor="@android:color/transparent"
        app:tabIndicatorGravity="center"
        app:tabIndicatorHeight="52.0dp"
        app:tabIndicatorFullWidth="true"
        app:tabIndicatorAnimationMode="elastic"
        app:tabIndicatorAnimationDuration="280"
        app:tabSelectedTextColor="@color/white"
        app:tabTextColor="#99FFFFFF"
        app:tabRippleColor="@android:color/transparent"
        app:tabBackground="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@id/main_bottom_view"
        android:visibility="gone"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <FrameLayout
        android:visibility="gone"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <com.mymovie.widget.ImageAdView
            android:visibility="gone"
            android:layout_width="0.0dp"
            android:layout_height="0.0dp" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
