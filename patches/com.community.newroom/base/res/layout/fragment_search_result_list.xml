<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@id/search_result_list_recycler"
        android:layout_width="match_parent"
        android:layout_height="0.0dp"
        android:clipToPadding="false"
        android:paddingTop="48.0dp"
        android:paddingLeft="12.0dp"
        android:paddingRight="12.0dp"
        android:paddingBottom="6.0dp"
        android:paddingHorizontal="12.0dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.github.mmin18.widget.RealtimeBlurView
        android:id="@id/blur_view"
        android:layout_width="match_parent"
        android:layout_height="0.0dp"
        app:realtimeBlurRadius="20.0dp"
        app:realtimeOverlayColor="#7A0B0B0F"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/search_result_list_tabs" />

    <com.transsion.search_pugc.widget.NoInterceptRecyclerView
        android:id="@id/search_result_list_tabs"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingBottom="6.0dp"
        android:overScrollMode="never"
        app:layout_constrainedWidth="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ProgressBar
        android:id="@id/search_result_tab_progress_bar"
        android:visibility="gone"
        android:layout_width="23.0dp"
        android:layout_height="23.0dp"
        android:indeterminateTint="@color/brand_new_50"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
