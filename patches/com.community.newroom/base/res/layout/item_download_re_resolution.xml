<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="28.0dp"
    style="@style/style_medium_text">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@id/iv_resolution"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        android:visibility="gone" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@id/tv_resolution"
        android:textColor="@color/text_01"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:visibility="gone"
        style="@style/style_medium_small_text" />

    <com.transsion.baseui.widget.GradientTextView
        android:id="@id/tv_resolution_selected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        app:gradientTvCenterColor="@color/brand_new_gradient_center"
        app:gradientTvEndColor="@color/brand_new_gradient_end"
        app:gradientTvStartColor="@color/brand_new_gradient_start"
        style="@style/style_medium_small_text" />
</androidx.appcompat.widget.LinearLayoutCompat>
